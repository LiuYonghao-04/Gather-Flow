{
  "name": "gather-flow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n API,WECHAT -c green,cyan \"npm:dev:api\" \"npm:dev:mp-weixin\"",
    "dev:api": "npm run dev -w @gatherflow/api",
    "dev:wechat-api": "npm run dev:wechat -w @gatherflow/api",
    "dev:lan": "concurrently -n DEMO,WECHAT -c green,cyan \"npm run dev:lan -w @gatherflow/api\" \"npm run dev:wechat-lan -w @gatherflow/api\"",
    "build:wechat": "npm run build:wechat -w @gatherflow/miniapp",
    "build:showcase": "tsx scripts/build-showcase.ts",
    "dev:mp-weixin": "npm run dev:mp-weixin -w @gatherflow/miniapp",
    "dev:h5": "npm run dev:h5 -w @gatherflow/miniapp",
    "db:migrate": "npm run db:migrate -w @gatherflow/api",
    "db:seed": "npm run db:seed -w @gatherflow/api",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write apps packages scripts docs *.json *.ts README.md",
    "format:check": "prettier --check apps packages scripts docs *.json *.ts README.md",
    "demo:m1": "tsx scripts/demo-m1.ts",
    "demo:m23": "tsx scripts/demo-m23.ts",
    "demo:m4": "npm run demo:m23 && tsx scripts/demo-m4.ts",
    "demo:m5": "npm run demo:m4",
    "demo:export": "tsx scripts/export-demo-preview.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "wechat:capture": "tsx scripts/wechat-capture.ts",
    "wechat:test": "npm run demo:m23 && tsx scripts/wechat-regression.ts",
    "wechat:login-test": "tsx scripts/wechat-login-smoke.ts",
    "wechat:guide-test": "tsx scripts/wechat-onboarding.ts",
    "wechat:showcase-test": "tsx scripts/wechat-showcase.ts",
    "build:api": "npm run build -w @gatherflow/api",
    "build:mp-weixin": "npm run build:mp-weixin -w @gatherflow/miniapp",
    "build:h5": "npm run build:h5 -w @gatherflow/miniapp",
    "build": "npm run build:api && npm run build:mp-weixin",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "concurrently": "9.2.1",
    "miniprogram-automator": "0.13.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
